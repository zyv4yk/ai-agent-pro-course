# Обовʼязково: ключ Anthropic для команди `f1-oracle predict`.
# Команди `model`, `backtest` і `next` працюють без ключа — вони не викликають LLM.
ANTHROPIC_API_KEY=sk-ant-...

# Необовʼязково — усе має розумні значення за замовчуванням.
F1_MODEL=anthropic:claude-opus-5
F1_SIMULATIONS=20000        # симуляцій Монте-Карло на прогноз
F1_BETA=3.0                 # крутість софтмакса, калібрована бектестом
F1_FORM_WINDOW=5            # скільки останніх гонок формують "форму"
F1_TRACK_HISTORY_YEARS=3    # скільки сезонів історії траси враховувати
F1_MODEL_CALL_LIMIT=12      # межа викликів моделі за один прогін
F1_TOOL_CALL_LIMIT=20       # межа викликів інструментів за один прогін
F1_SEED=42

# Альтернатива ключу — OAuth-профіль (`ant auth login`), тоді замість ANTHROPIC_API_KEY
# у середовищі має бути ANTHROPIC_AUTH_TOKEN:
#   set -a; eval "$(ant auth print-credentials --env)"; set +a
# Токен короткоживучий — перед довгим прогоном евалів оновіть його цією ж командою.
# F1_MAX_TOKENS=8000        # стеля відповіді моделі
